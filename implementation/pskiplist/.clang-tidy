# performance-inefficient-vector-operation (reserve() before a loop of emplace_back) is
# disabled as not worth enforcing on the example's small, fixed-size loop.
Checks: >
  -*,
  bugprone-*,
  performance-*,
  -performance-inefficient-vector-operation,
  modernize-*,
  readability-*

WarningsAsErrors: >
  bugprone-*,
  performance-*,
  modernize-*,
  readability-*

HeaderFilterRegex: '(^|.*/)detail/.*\.hpp$'
FormatStyle: none
