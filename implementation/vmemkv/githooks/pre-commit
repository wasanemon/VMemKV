#!/bin/bash
# Pre-commit hook to run clang-format on changed C++ files.

# Find all staged C++ files (excluding third-party or build directories)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|hpp|c|h|cc|cxx)$' | grep -v 'build/' | grep -v 'third_party/')

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo "Running clang-format on staged C++ files..."

# Check if clang-format is available
if ! command -v clang-format &> /dev/null; then
    echo "Warning: clang-format not found in PATH. Skipping auto-formatting."
    exit 0
fi

# Run clang-format and re-add the formatted files
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        clang-format -i "$file"
        git add "$file"
    fi
done

echo "Auto-formatting complete."
exit 0
